[Unit]
Description=Palinode API Server (FastAPI / uvicorn)
Documentation=https://github.com/phasespace-labs/palinode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${PALINODE_HOME}
Environment="PALINODE_DIR=${PALINODE_DATA_DIR}"
Environment="OLLAMA_URL=${OLLAMA_URL}"
Environment="EMBEDDING_MODEL=${EMBEDDING_MODEL}"
# Bind. The API binds 0.0.0.0 so it is reachable over Tailscale (or any other
# interface). PALINODE_API_HOST mirrors uvicorn's --host so the app's startup
# gate sees the real bind: a non-loopback bind with no PALINODE_API_TOKEN
# REFUSES TO START unless PALINODE_API_ALLOW_UNAUTH=1 is set explicitly.
#   - Token: add PALINODE_API_TOKEN (or PALINODE_API_TOKEN_FILE) via a drop-in
#     (`systemctl edit palinode-api`) — do not bake secrets into this unit.
#   - Token-less, network-isolated host (Tailscale-only, firewalled): render
#     with PALINODE_API_ALLOW_UNAUTH=1; the API starts and warns on every start.
# PALINODE_API_BIND_INTENT=public declares intentional public exposure and
# suppresses that warning, but still REQUIRES a token — only set it alongside
# one. (Empty is treated as "not public" — a value-based check.) See SECURITY.md.
Environment="PALINODE_API_HOST=0.0.0.0"
Environment="PALINODE_API_ALLOW_UNAUTH=${PALINODE_API_ALLOW_UNAUTH}"
Environment="PALINODE_API_BIND_INTENT=${PALINODE_API_BIND_INTENT}"
ExecStart=${PALINODE_HOME}/venv/bin/uvicorn palinode.api.server:app --host 0.0.0.0 --port ${API_PORT}
Restart=always
RestartSec=5

# Structured JSON logs → journalctl; no custom log file needed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=palinode-api

[Install]
WantedBy=${SYSTEMD_WANTED_BY}
