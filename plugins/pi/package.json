{
  "name": "pi-palinode",
  "version": "0.1.0",
  "type": "module",
  "description": "Palinode persistent memory for the Pi coding agent — per-turn recall, session priming, and capture, as a thin adapter over the Palinode REST API",
  "main": "./dist/pi/src/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/src/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
